#!/bin/sh
. "$HOME/.config/yadm/lib.sh"

seed theme.zsh                "$HOME/.config/theme.zsh"
seed "zshenv.local.$OS"       "$HOME/.zshenv.local"
seed "zshrc.local.$OS"        "$HOME/.zshrc.local"
seed localtheme.lua           "$HOME/.config/nvim/lua/localtheme.lua"
seed delta-theme.gitconfig    "$HOME/.config/delta-theme.gitconfig"

# Layer-specific hooks
for f in "$HOME"/.config/yadm/bootstrap.d/*.sh; do
    [ -x "$f" ] && "$f"
done
