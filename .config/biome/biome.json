{
	"$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},

	"files": {
		"ignoreUnknown": true
	},

	"formatter": {
		"useEditorconfig": true,
		"indentStyle": "space",
		"indentWidth": 2
	},

	"css": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single"
		}
	},

	"html": {
		"formatter": {
			"enabled": true,
			"selfCloseVoidElements": "always",
			"whitespaceSensitivity": "css",
			"attributePosition": "multiline"
		}
	}
}
