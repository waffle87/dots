{
    "clock": {
        "calendar": {
            "format": {
                "days": "<span color='#5E5E5E'><b>{}</b></span>",
                "months": "<span color='#4A4A4A'><b>{}</b></span>",
                "today": "<span color='#F85552'><b><u>{}</u></b></span>",
                "weekdays": "<span color='#8DA101'><b>{}</b></span>",
                "weeks": "<span color='#DFA000'><b>W{}</b></span>"
            },
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right"
        },
        "format": "\uf017 {:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "custom/date": {
        "exec": "~/.config/scripts/date.sh",
        "format": "\uf133 {}",
        "interval": 60
    },
    "custom/media": {
        "escape": true,
        "exec": "~/.config/scripts/mediaplayer.py 2> /dev/null",
        "format": "{0} {1}",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-down": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "return-type": "json"
    },
    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "focused": "\uf192",
	    "default": "\uf111"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
            "7": []
        }
    },
    "layer": "top",
    "modules-center": ["sway/workspaces"],
    "modules-left": ["temperature", "wireplumber", "network"],
    "modules-right": ["custom/media", "custom/date", "clock"],
    "network": {
	"family": "ipv4",
        "format-disconnected": "\udb85\udebc  disconnected",
        "format-wifi": "\uf1eb  {ipaddr}/{cidr}",
        "tooltip-format-wifi": "\uf1eb  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\n\uf093 {bandwidthUpBits} \uf019 {bandwidthDownBits}",
        "format-ethernet": "\uf1eb  {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "\uf1eb  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\n\uf093 {bandwidthUpBits} \uf019 {bandwidthDownBits}"
    },
    "output": "DP-1",
    "position": "bottom",
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": ["\uf027", "\uf028"],
            "headphone": "\uf025"
        },
        "format-muted": "\uf026 muted",
        "on-click": "~/.config/scripts/output.sh"
    },
    "temperature": {
        "critical-threshold": 85,
        "format": "\uf2c9 {temperatureC}\u00b0C",
        "format-critical": "\uf071 {temperatureC}\u00b0C",
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input"
    }
}
