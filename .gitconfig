[user]
  name = Jack Sangdahl
  email = jack@pngu.org
  signingkey = FC53C827D09C7050
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[include]
  path = ~/.config/onedark-delta.gitconfig
[delta]
  navigate = true
  dark = true
  line-numbers = true
  features = onedark-theme
[merge]
  conflictStyle = zdiff3
[commit]
  gpgsign = true
